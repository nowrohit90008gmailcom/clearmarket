# Copy this file to backend/.env and fill values.
# NEVER commit your real .env file.

# Runtime mode: development | production
APP_ENV=production

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/clearmarket
DB_NAME=clearmarket

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# AI/Market provider keys
EMERGENT_LLM_KEY=your_llm_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Comma-separated list of allowed frontend origins.
# In production, '*' is blocked by server startup validation.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
